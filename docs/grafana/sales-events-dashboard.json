{
  "title": "sales-events",
  "uid": "sales-events",
  "schemaVersion": 39,
  "tags": [
    "sales-events"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "RED: serviços (Rate, Errors, Duration)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Requisições por segundo",
      "description": "Rate: quanto tráfego cada endpoint recebe.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, method, uri) (rate(http_server_requests_milliseconds_count{uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{method}} {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Erros 5xx por segundo",
      "description": "Errors: falha do servidor. 4xx é erro do cliente e fica fora.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_requests_milliseconds_count{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Latência p95 e p99",
      "description": "Duration em percentil: a média esconde quem espera mais.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_requests_milliseconds_bucket{uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_requests_milliseconds_bucket{uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p99 {{service_name}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 5,
      "title": "USE: recursos (Utilization, Saturation, Errors)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Pool de conexões: uso",
      "description": "Utilization: conexões em uso sobre o máximo do Hikari.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hikaricp_connections_active / hikaricp_connections_max",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Pool de conexões: espera e timeouts",
      "description": "Saturation: threads esperando conexão. Errors: timeouts ao pedir conexão.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "esperando {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (service_name) (increase(hikaricp_connections_timeout_total[$__rate_interval]))",
          "legendFormat": "timeouts {{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Threads do Tomcat: uso",
      "description": "Utilization do servidor HTTP: threads ocupadas sobre o máximo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "tomcat_threads_busy / tomcat_threads_config_max",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Heap da JVM",
      "description": "Memória usada no heap, por serviço.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Pausas de GC",
      "description": "Saturation da JVM: milissegundos parados em GC por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (rate(jvm_gc_pause_milliseconds_sum[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Mensageria: outbox, Kafka e DLT",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Outbox: eventos pendentes",
      "description": "Lag do produtor: gravados no banco e ainda não publicados.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "outbox_events_pending",
          "legendFormat": "pendentes"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Outbox: idade do mais antigo",
      "description": "Relay travado aparece aqui mesmo com poucas linhas pendentes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "outbox_events_oldest_age_seconds",
          "legendFormat": "idade"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Lag do consumidor",
      "description": "Mensagens no tópico que o inventory-service ainda não leu, por partição.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (topic, partition) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{topic}} p{{partition}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 15,
      "title": "Mensagens no DLT (no período)",
      "description": "Falhas que ninguém viu: cada uma pede investigação.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "round(sum(increase(orders_dead_letter_total[$__range])))",
          "legendFormat": "DLT"
        }
      ]
    }
  ]
}
